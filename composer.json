{
    "name": "otopark/app",
    "description": "Otopark yönetim paneli (PHP + PostgreSQL)",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php"
    }
}
